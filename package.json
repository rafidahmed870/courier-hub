{
  "name": "courier-hub",
  "version": "0.1.0",
  "description": "One API for every courier in Bangladesh. A type-safe, tree-shakeable SDK for Steadfast, Pathao, RedX — create orders, track parcels, cancel shipments.",
  "keywords": [
    "bangladesh",
    "courier",
    "sdk",
    "courier-hub",
    "courier-service",
    "pathao",
    "steadfast",
    "delivery",
    "shipping",
    "logistics",
    "typescript",
    "nodejs",
    "javascript"
  ],
  "homepage": "https://github.com/rafidahmed870/courier-hub#readme",
  "bugs": {
    "url": "https://github.com/rafidahmed870/courier-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafidahmed870/courier-hub.git"
  },
  "license": "MIT",
  "author": "Rafid Ahmed",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs",
      "default": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src tests",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
